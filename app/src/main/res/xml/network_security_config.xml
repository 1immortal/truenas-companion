<?xml version="1.0" encoding="utf-8"?>
<!--
  1.7.1: no cleartext traffic at all. The app signs in to TrueNAS only over HTTPS; self-signed certificates are handled
  in code by certificate pinning (trust on first use, see data/net/HttpClients.kt), not by trusting user CAs globally.
  The NAS clients additionally refuse any non-https request (HttpsOnlyInterceptor).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
